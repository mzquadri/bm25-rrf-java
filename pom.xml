<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.mzquadri</groupId>
  <artifactId>bm25-rrf</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>bm25-rrf</name>
  <description>
    Okapi BM25 and reciprocal rank fusion on the JVM, held to the rankings of an
    existing Python implementation by a parity test.
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <junit.version>5.11.3</junit.version>
    <jackson.version>2.18.2</jackson.version>
  </properties>

  <dependencies>
    <!-- The main sources have no dependencies at all. BM25 and RRF need
         arithmetic, a hash and a regex, so a retrieval library here would only
         hide the thing this repository exists to show. -->

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Test scope only, to read the fixtures exported from Python. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- The fixtures are UTF-8 and the corpus contains em dashes and
               curly quotes. Without this, a JVM defaulting to a Windows
               code page reads them wrongly and the parity test fails for a
               reason that has nothing to do with retrieval. -->
          <argLine>-Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
